{
  "$id": "https://plotpilot.local/contracts/story-state-projection-input-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "asset_id",
          "sha256",
          "role"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "payload_asset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "target": {
          "additionalProperties": false,
          "properties": {
            "entity_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            "entity_kind": {
              "enum": [
                "document",
                "node_structure",
                "relation_set"
              ]
            },
            "workspace_id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "workspace_id",
            "entity_kind",
            "entity_id"
          ],
          "type": "object"
        }
      },
      "required": [
        "candidate_id",
        "target",
        "payload_asset_id",
        "payload_hash",
        "status"
      ],
      "type": "object"
    },
    "current_revision": {
      "additionalProperties": false,
      "properties": {
        "content_asset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "revision_id",
        "content_asset_id",
        "content_hash",
        "revision_number"
      ],
      "type": "object"
    },
    "derived_at": {
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.(?!000)[0-9]{3}Z)$",
      "type": "string"
    },
    "projection_input_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "package_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "parent_receipt_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "receipt_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "run_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "receipt_hash",
        "run_snapshot_hash",
        "release_id",
        "package_hash",
        "parent_receipt_ids"
      ],
      "type": "object"
    },
    "publication": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "publication_id",
        "candidate_id",
        "revision_id",
        "revision_number",
        "content_hash"
      ],
      "type": "object"
    },
    "receipt_closure": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "parent_receipt_ids": {
            "items": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
              "type": "string"
            },
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "receipt_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "receipt_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "receipt_id",
          "receipt_hash",
          "parent_receipt_ids"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "story-state-projection-input/v2"
    },
    "workspace_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "projection_input_id",
    "workspace_id",
    "publication",
    "candidate",
    "current_revision",
    "assets",
    "provenance",
    "receipt_closure",
    "derived_at"
  ],
  "title": "PlotPilot story-state-projection-input-v2",
  "type": "object"
}
