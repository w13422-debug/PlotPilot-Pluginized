          "minItems": 0,
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "pattern": "^(?:candidate|job|core)/[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema": {
          "const": "plugin-discovery-result/v2"
